on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1
    setprop mtp.crash_check 0

# lamu does not provide the legacy CONFIG_USB_CONFIGFS_F_MTP function, but it
# does provide the generic FunctionFS gadget used by OrangeFox's MTP backend.
# The common recovery init creates ffs.adb and ffs.fastboot; add the missing
# MTP instance after configfs is initialized.
on post-fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    write /config/usb_gadget/g1/functions/ffs.mtp/os_desc/interface.MTP/compatible_id "MTP"
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=0,gid=0,no_disconnect=1

# OrangeFox starts its in-process FunctionFS MTP server after selecting the
# mtp,adb composition. Keep adbd alive and bind both ready FunctionFS instances
# to the same gadget so enabling MTP does not sacrifice recovery ADB.
on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# The common recovery rule removes f1 when switching to "none". Remove the
# second link as well so disabling and re-enabling MTP is repeatable.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

# The proprietary lamu KeyMint/Gatekeeper services target the Android 16
# runtime. They cannot be linked by fox_12.1's Android 12 linker, so the
# synchronous resyncapex hook starts these services through the mounted
# system bootstrap linker before metadata decryption begins.
service lamu-mobicore /vendor/bin/mcDriverDaemon --P1 /mnt/vendor/persist/mcRegistry
    disabled
    user root
    group root system
    seclabel u:r:recovery:s0

service lamu-servicemanager16 /system_root/system/bin/bootstrap/linker64 /system_root/system/bin/servicemanager
    disabled
    user root
    group root
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/vendor/lib64:/system_root/system/lib64/bootstrap

service lamu-keymint16 /system_root/system/bin/bootstrap/linker64 /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustonic
    disabled
    user root
    group root system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/vendor/lib64:/system_root/system/lib64/bootstrap

service lamu-gatekeeper16 /system_root/system/bin/bootstrap/linker64 /vendor/bin/hw/android.hardware.gatekeeper-service.trustonic
    disabled
    user root
    group root system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/vendor/lib64:/system_root/system/lib64/bootstrap

service lamu-gatekeeperd16 /system_root/system/bin/bootstrap/linker64 /system_root/system/bin/gatekeeperd /data/misc/gatekeeper
    disabled
    user system
    group system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/vendor/lib64:/apex/com.android.i18n/lib64:/system_root/system/lib64/bootstrap

service lamu-keystore16 /system_root/system/bin/bootstrap/linker64 /system_root/system/bin/keystore2 /tmp/misc/keystore
    disabled
    user root
    group root keystore readproc log
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/vendor/lib64:/apex/com.android.i18n/lib64:/system_root/system/lib64/bootstrap

service lamu-vold16 /system_root/system/bin/bootstrap/linker64 /system_root/system/bin/vold --blkid_context=u:r:recovery:s0 --blkid_untrusted_context=u:r:recovery:s0 --fsck_context=u:r:recovery:s0 --fsck_untrusted_context=u:r:recovery:s0
    disabled
    user root
    group root system reserved_disk
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/vendor/lib64:/apex/com.android.i18n/lib64:/system_root/system/lib64/bootstrap
