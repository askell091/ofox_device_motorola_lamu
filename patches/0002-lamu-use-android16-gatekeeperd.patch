+static bool write_all(int fd, const void* data, size_t size) {
+	const uint8_t* current = static_cast<const uint8_t*>(data);
+	while (size > 0) {
+		ssize_t written = write(fd, current, size);
+		if (written < 0) {
+			if (errno == EINTR) continue;
+			return false;
+		}
+		if (written == 0) return false;
+		current += written;
+		size -= written;
+	}
+	return true;
+}
+
+static bool verify_with_android16_gatekeeper(
+		const userid_t user_id, const void* password_handle,
+		const uint32_t handle_size, const void* password_token,
+		const uint32_t token_size) {
+	char request_path[] = "/tmp/lamu-gatekeeper-request-XXXXXX";
+	char response_path[] = "/tmp/lamu-gatekeeper-response-XXXXXX";
+	int request_fd = mkstemp(request_path);
+	if (request_fd < 0) return false;
+	int response_fd = mkstemp(response_path);
+	if (response_fd < 0) {
+		close(request_fd);
+		unlink(request_path);
+		return false;
+	}
+	close(response_fd);
+
+	int32_t gatekeeper_user_id = fakeUid(user_id);
+	bool request_ok = write_all(request_fd, &gatekeeper_user_id, sizeof(gatekeeper_user_id)) &&
+		write_all(request_fd, &handle_size, sizeof(handle_size)) &&
+		write_all(request_fd, &token_size, sizeof(token_size)) &&
+		write_all(request_fd, password_handle, handle_size) &&
+		write_all(request_fd, password_token, token_size);
+	if (fsync(request_fd) != 0) request_ok = false;
+	close(request_fd);
+	if (!request_ok) {
+		unlink(request_path);
+		unlink(response_path);
+		return false;
+	}
+
+	pid_t child = fork();
+	if (child == 0) {
+		setenv("LD_LIBRARY_PATH",
+			"/system_root/system/lib64:/vendor/lib64:/apex/com.android.i18n/lib64:"
+			"/system_root/system/lib64/bootstrap:/system/lib64", 1);
+		execl("/system_root/system/bin/bootstrap/linker64", "linker64",
+			"/system/bin/lamu_gatekeeper16", request_path, response_path,
+			static_cast<char*>(nullptr));
+		_exit(127);
+	}
+
+	int status = 0;
+	bool helper_ok = child > 0;
+	while (helper_ok && waitpid(child, &status, 0) < 0) {
+		if (errno != EINTR) helper_ok = false;
+	}
+	helper_ok = helper_ok && WIFEXITED(status) && WEXITSTATUS(status) == 0;
+
+	std::string response;
+	if (helper_ok) {
+		helper_ok = android::base::ReadFileToString(response_path, &response) &&
+			response.size() >= sizeof(hw_auth_token_t);
+	}
+	unlink(request_path);
+	unlink(response_path);
+	return helper_ok;
+}
