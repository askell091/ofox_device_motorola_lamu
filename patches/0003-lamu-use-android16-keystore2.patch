+static bool unwrap_with_android16_keystore(
+		const std::string& alias, const void* iv, uint32_t iv_size,
+		const void* ciphertext, uint32_t ciphertext_size,
+		std::vector<uint8_t>* plaintext) {
+	if (alias.empty() || !iv || iv_size != 12 || !ciphertext ||
+		ciphertext_size == 0 || !plaintext ||
+		alias.size() > UINT32_MAX) return false;
+
+	char request_path[] = "/tmp/lamu-keystore-request-XXXXXX";
+	char response_path[] = "/tmp/lamu-keystore-response-XXXXXX";
+	int request_fd = mkstemp(request_path);
+	if (request_fd < 0) return false;
+	int response_fd = mkstemp(response_path);
+	if (response_fd < 0) {
+		close(request_fd);
+		unlink(request_path);
+		return false;
+	}
+	close(response_fd);
+
+	uint32_t alias_size = alias.size();
+	bool request_ok = write_all(request_fd, &alias_size, sizeof(alias_size)) &&
+		write_all(request_fd, &iv_size, sizeof(iv_size)) &&
+		write_all(request_fd, &ciphertext_size, sizeof(ciphertext_size)) &&
+		write_all(request_fd, alias.data(), alias.size()) &&
+		write_all(request_fd, iv, iv_size) &&
+		write_all(request_fd, ciphertext, ciphertext_size);
+	if (fsync(request_fd) != 0) request_ok = false;
+	close(request_fd);
+	if (!request_ok) {
+		unlink(request_path);
+		unlink(response_path);
+		return false;
+	}
+
+	pid_t child = fork();
+	if (child == 0) {
+		setenv("LD_LIBRARY_PATH",
+			"/system_root/system/lib64:/vendor/lib64:/apex/com.android.i18n/lib64:"
+			"/system_root/system/lib64/bootstrap:/system/lib64", 1);
+		execl("/system_root/system/bin/bootstrap/linker64", "linker64",
+			"/system/bin/lamu_gatekeeper16", "unwrap", request_path,
+			response_path, static_cast<char*>(nullptr));
+		_exit(127);
+	}
+
+	int status = 0;
+	bool helper_ok = child > 0;
+	while (helper_ok && waitpid(child, &status, 0) < 0) {
+		if (errno != EINTR) helper_ok = false;
+	}
+	if (helper_ok && WIFEXITED(status) && WEXITSTATUS(status) != 0)
+		printf("Android 16 Keystore2 helper exited with status %d\n",
+			WEXITSTATUS(status));
+	helper_ok = helper_ok && WIFEXITED(status) && WEXITSTATUS(status) == 0;
+
+	std::string response;
+	if (helper_ok) {
+		helper_ok = android::base::ReadFileToString(response_path, &response) &&
+			response.size() >= 12 && response.size() <= 64 * 1024;
+	}
+	unlink(request_path);
+	unlink(response_path);
+	if (!helper_ok) return false;
+	plaintext->assign(response.begin(), response.end());
+	return true;
+}
